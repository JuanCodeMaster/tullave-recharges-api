  <diagram id="flujo" name="Flujo de una petición">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
        <mxCell id="f1" parent="f0" />

        <mxCell id="f-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;Flujo de POST /api/v1/recharges&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;camino feliz (201) y camino de error (400 / 404)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="f1">
          <mxGeometry x="40" y="20" width="620" height="50" as="geometry" />
        </mxCell>

        <!-- Camino feliz -->
        <mxCell id="s1" value="&lt;b&gt;1. Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;POST JSON&lt;br&gt;{cardNumber, amount, paymentMethod}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="40" y="150" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. RechargeController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Jackson deserializa → RechargeRequest&lt;br&gt;@Valid: 16 dígitos, 2.000–200.000, enum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6DB33F;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="250" y="150" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. RechargeServiceImpl.create&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;@Transactional · log INFO (tarjeta ****5678)&lt;br&gt;RechargeMapper.toEntity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6DB33F;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="490" y="150" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. RechargeRepository.save&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;@PrePersist: reference = UUID, createdAt = now&lt;br&gt;INSERT vía Hibernate / HikariCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6DB33F;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="730" y="150" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;CHECK constraints · id BIGSERIAL&lt;br&gt;commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#336791;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="970" y="150" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Respuesta 201 Created&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Location: /api/v1/recharges/{id}&lt;br&gt;body: RechargeResponse (id, reference, cardNumber, amount, paymentMethod, createdAt)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="250" y="290" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#424242;" edge="1" parent="f1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6DB33F;" edge="1" parent="f1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6DB33F;" edge="1" parent="f1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#336791;" edge="1" parent="f1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" value="toResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="f1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1050" y="320" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="f1" source="s6" target="s1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="125" y="320" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- Camino de error -->
        <mxCell id="err-title" value="&lt;b&gt;Camino de error&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#E65100;" vertex="1" parent="f1">
          <mxGeometry x="40" y="420" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="&lt;b&gt;Excepción&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;MethodArgumentNotValidException (body)&lt;br&gt;ConstraintViolationException (query params)&lt;br&gt;HttpMessageNotReadableException (enum / JSON)&lt;br&gt;ResourceNotFoundException (id inexistente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="40" y="455" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;GlobalExceptionHandler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;@RestControllerAdvice&lt;br&gt;log WARN (cliente) · ERROR (inesperado)&lt;br&gt;construye ErrorResponse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=11;" vertex="1" parent="f1">
          <mxGeometry x="350" y="455" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="&lt;b&gt;Respuesta 400 / 404 / 405 / 500&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;{ timestamp, status, error, message, path,&lt;br&gt;errors: [ { field, message } ] }&lt;br&gt;sin stack trace ni detalles internos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;" vertex="1" parent="f1">
