                  "    pm.expect(body.page).to.eql(0);",
                  "    pm.expect(body.size).to.eql(10);",
                  "});",
                  "pm.test('Contiene las recargas creadas', () => pm.expect(body.totalElements).to.be.at.least(3));",
                  "pm.test('Ordenado por fecha descendente', () => {",
                  "    const dates = body.content.map(r => r.createdAt);",
                  "    const sorted = [...dates].sort().reverse();",
                  "    pm.expect(dates).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/getRecharges", "host": ["{{baseUrl}}"], "path": ["api", "v1", "getRecharges"] }
